def private_regular(path: Path, executable: bool = False) -> bool:
    try:
        stat_result = path.stat(follow_symlinks=False)
    except OSError:
        return False
    if not path.is_file() or stat_result.st_mode & 0o022:
        return False
    if executable and not stat_result.st_mode & 0o100:
        return False
    return True


def _local_identity() -> tuple[int, set[int]] | None:
    try:
        account = pwd.getpwnam(LOCAL_OWNER_NAME)
    except KeyError:
        return None
    groups = {account.pw_gid}
    groups.update(
        entry.gr_gid for entry in grp.getgrall() if account.pw_name in entry.gr_mem
    )
    return account.pw_uid, groups


def _private_owner_group(owner_uid: int, group_gid: int) -> bool:
    """Allow group write only when the group is private to the file owner."""
    try:
        account = pwd.getpwuid(owner_uid)
        group = grp.getgrgid(group_gid)
    except KeyError:
        return False
    if account.pw_gid != group_gid or group.gr_name != account.pw_name:
        return False
    if any(member != account.pw_name for member in group.gr_mem):
        return False
    return all(
        entry.pw_uid == owner_uid
        for entry in pwd.getpwall()
        if entry.pw_gid == group_gid
    )


def _trusted_mode(metadata: os.stat_result) -> bool:
    if metadata.st_mode & 0o002:
        return False
    if metadata.st_mode & 0o020 and not _private_owner_group(
        metadata.st_uid, metadata.st_gid
    ):
        return False
    return True


def _identity_can_execute(
    metadata: os.stat_result, user_uid: int, group_gids: set[int]
) -> bool:
    if metadata.st_uid == user_uid:
        return bool(metadata.st_mode & stat.S_IXUSR)
    if metadata.st_gid in group_gids:
        return bool(metadata.st_mode & stat.S_IXGRP)
    return bool(metadata.st_mode & stat.S_IXOTH)


def _trusted_parent_chain(
    path: Path, allowed_owner_uids: set[int], user_uid: int, group_gids: set[int]
) -> bool:
    current = path.parent
    while True:
        try:
            metadata = current.stat()
        except OSError:
            return False
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid not in allowed_owner_uids
            or not _trusted_mode(metadata)
            or not _identity_can_execute(metadata, user_uid, group_gids)
        ):
            return False
        if current == current.parent:
            return True
        current = current.parent


def trusted_executable(path: Path) -> bool:
    """Validate a regular executable or a symlink to one without weakening trust."""
    identity = _local_identity()
    if identity is None:
        return False
    user_uid, group_gids = identity
    allowed_owner_uids = {0, user_uid}
    lexical_path = Path(os.path.abspath(path))
    try:
        link_metadata = lexical_path.lstat()
    except OSError:
        return False
    if stat.S_ISLNK(link_metadata.st_mode):
        if link_metadata.st_uid not in allowed_owner_uids:
            return False
    try:
        # Resolve even a regular leaf so symlinked parent directories are
        # validated through their actual target path as well.
        resolved = lexical_path.resolve(strict=True)
    except (OSError, RuntimeError):
        return False
    try:
        target_metadata = resolved.stat()
    except OSError:
        return False
    return bool(
        stat.S_ISREG(target_metadata.st_mode)
        and target_metadata.st_uid in allowed_owner_uids
        and _trusted_mode(target_metadata)
        and _identity_can_execute(target_metadata, user_uid, group_gids)
        and _trusted_parent_chain(
            lexical_path, allowed_owner_uids, user_uid, group_gids
        )
        and _trusted_parent_chain(resolved, allowed_owner_uids, user_uid, group_gids)
    )


def validate_pool_key() -> tuple[bool, str]:
    try:
        key = parse_env_key(ENV_FILE)
        configured_ids = set(configured_connections().values())
        connection = sqlite3.connect(f"file:{DB_FILE}?mode=ro", uri=True, timeout=5)
        row = connection.execute(
            """
            SELECT allowed_models,allowed_connections,is_active,is_banned,revoked_at,
                   exclusive_session_connections
            FROM api_keys WHERE name=? AND (key=? OR key_hash=?)
            """,
            (POOL_KEY_NAME, key, hashlib.sha256(key.encode()).hexdigest()),
        ).fetchone()
        connection.close()
        if not row:
            return False, "pooled API key is not registered"
        models = set(json.loads(row[0] or "[]"))
        connections = set(json.loads(row[1] or "[]"))
        valid = bool(
            models == MODEL_ALIASES
            and connections == configured_ids
            and int(row[2] or 0) == 1
            and int(row[3] or 0) == 0
            and not row[4]
            and int(row[5] or 0) == 1
        )
        return valid, "OK" if valid else "pooled API key restrictions do not match config"
    except (OSError, ValueError, sqlite3.Error, RuntimeError) as error:
        return False, str(error)


def doctor_command() -> int:
    checks: list[tuple[str, bool, str]] = []
    checks.append(("CODEX_BINARY", trusted_executable(CODEX_BIN), str(CODEX_BIN)))
    checks.append(("PROFILE_PRIVATE", private_regular(PROFILE_FILE), str(PROFILE_FILE)))
    checks.append(("ENV_PRIVATE", private_regular(ENV_FILE), str(ENV_FILE)))
    profile_text = PROFILE_FILE.read_text(encoding="utf-8") if PROFILE_FILE.is_file() else ""
    checks.append(("RESPONSES_API", 'wire_api = "responses"' in profile_text, "responses"))
    checks.append(("XHIGH", 'model_reasoning_effort = "xhigh"' in profile_text, REASONING))
    checks.append(("EXTERNAL_AFFINITY", "X-Session-Id" in profile_text, "env_http_headers"))
    pool_ok, pool_detail = validate_pool_key()
    checks.append(("POOL_RESTRICTIONS", pool_ok, pool_detail))
    try:
        db_ok = sqlite3.connect(f"file:{DB_FILE}?mode=ro", uri=True).execute(
            "PRAGMA quick_check"
        ).fetchone()[0] == "ok"
    except sqlite3.Error:
        db_ok = False
    checks.append(("DATABASE", db_ok, "quick_check"))
    checks.append(("ROUTES_CONFIGURED", len(route_snapshot()) > 1, str(len(route_snapshot()))))
    checks.append(("STATE_PERMISSIONS", (STATE_ROOT.stat().st_mode & 0o777) == 0o700, str(STATE_ROOT)))
    for name, ok, detail in checks:
        print(f"CHECK_{name}={'PASS' if ok else 'FAIL'} DETAIL={detail}")
    print("MODEL_REQUESTS=0")
    result = all(ok for _, ok, _ in checks)
    print(f"DOCTOR={'GREEN' if result else 'RED'}")
    return 0 if result else 1


def dry_run_command() -> int:
    routes = route_snapshot()
    ready = [route for route in routes if route["ready"]]
    print(f"CODEX_ACCOUNT_SELECTED={'NATIVE_POOL' if ready else 'NONE'}")
    print(f"STATUS={'READY' if ready else 'NO_READY_ACCOUNT'}")
    print(f"MODEL={MODEL}")
    print(f"REASONING={REASONING}")
    print("SESSION_PINNING=EXTERNAL_AFFINITY_WITH_FAILED_PIN_EVICTION")
    print("MODEL_REQUESTS=0")
    return 0 if ready else 3


def parse_args(arguments: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--task")
    parser.add_argument("--state")
    parser.add_argument("--wait-for-capacity", action="store_true")
    parser.add_argument("--max-handoffs", type=int, default=MAX_HANDOFFS)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--managed-profile")
    parser.add_argument("--managed-env-file")
    parser.add_argument("--help", action="store_true")
    known, codex_args = parser.parse_known_args(arguments)
    known.codex_args = codex_args
    return known


def print_help() -> None:
    print(
        "usage: codex-omni [--task FILE] [--state FILE] [CODEX_ARGS...]\n"
        "       codex-omni status\n"
        "       codex-omni doctor\n\n"
        "Native OmniRoute continuity preserves the live Responses request across 429 account rotation.\n"
        "A parked WAITING_FOR_CAPACITY run is resumed explicitly on a later launch."
    )


def launch(arguments: list[str]) -> int:
    options = parse_args(arguments)
    if options.help:
        print_help()
        return 0
    if options.dry_run:
        return dry_run_command()
    if options.max_handoffs < 1 or options.max_handoffs > 50:
        raise RuntimeError("--max-handoffs must be between 1 and 50")
    if bool(options.managed_profile) != bool(options.managed_env_file):
        raise RuntimeError("--managed-profile and --managed-env-file must be used together")
    effective_profile = options.managed_profile or PROFILE
    effective_env_file = (
        Path(options.managed_env_file).resolve()
        if options.managed_env_file
        else ENV_FILE
    )
    if options.managed_profile and not re.fullmatch(r"[A-Za-z0-9._-]{1,128}", effective_profile):
        raise RuntimeError("invalid managed profile")
    if not private_regular(effective_env_file):
        raise RuntimeError("managed environment file must be a private regular file")
    if not private_regular(LEASE_HELPER):
        raise RuntimeError("exclusive lease helper must be a trusted regular file")
    task = Path(options.task).resolve() if options.task else None
    project_state = Path(options.state).resolve() if options.state else None
    if task and (not task.is_file() or not os.access(task, os.R_OK)):
        raise RuntimeError("--task must name a readable regular file")
    if project_state and project_state.exists() and not project_state.is_file():
        raise RuntimeError("--state must name a regular file or a not-yet-created file")

    pending = pending_waiting_manifest()
    if pending and (task or project_state):
        pending_task = pending.get("task_file")
        pending_state = pending.get("project_state_file")
        same_task = not task or pending_task == str(task)
        same_state = not project_state or pending_state == str(project_state)
        if not (same_task and same_state):
            pending = None
    routes = route_snapshot()
    ready = [route for route in routes if route["ready"]]
    capacity_state, capacity_reason = capacity_assessment(routes)
    if pending and not ready:
        if capacity_state == "UNVERIFIED":
            invalidate_false_waiting(pending, routes, capacity_reason)
            print("STATUS=CAPACITY_UNVERIFIED")
            print(f"DETAIL={capacity_reason}")
            print(f"STATE_PATH={run_path(str(pending['run_id']))}")
            return EXIT_CONFIG
        print("STATUS=WAITING_FOR_CAPACITY")
        print(f"STATE_PATH={run_path(str(pending['run_id']))}")
        print(f"RETRY_AT={pending.get('retry_at') or 'UNKNOWN'}")
        return EXIT_WAITING
    if not ready:
        if capacity_state == "UNVERIFIED":
            print("STATUS=CAPACITY_UNVERIFIED")
            print(f"DETAIL={capacity_reason}")
            print("ACTION=RECONCILE_OR_REVIEW_ROUTE_CONFIGURATION")
            return EXIT_CONFIG
        run_id = str(uuid.uuid4())
        cwd = Path.cwd().resolve()
        manifest = {
            "schema_version": SCHEMA_VERSION,
            "run_id": run_id,
            "architecture": ARCHITECTURE,
            "status": "WAITING_FOR_CAPACITY",
            "created_at": iso_now(),
            "started_at": iso_now(),
            "started_epoch": time.time(),
            "cwd": str(cwd),
            "model": MODEL,
            "reasoning": REASONING,
            "continuity_mode": "NEW_SESSION",
            "task_file": str(task) if task else None,
            "project_state_file": str(project_state) if project_state else None,
            "git": git_metadata(cwd),
            "handoff_count": 0,
            "max_handoffs": options.max_handoffs,
            "handoff_reason": "NO_READY_ROUTE_AT_LAUNCH",
            "route_snapshot": routes,
            "retry_at": None,
        }
        write_manifest(manifest)
        print("STATUS=WAITING_FOR_CAPACITY")
        print(f"STATE_PATH={run_path(run_id)}")
        return EXIT_WAITING

    key = parse_env_key(effective_env_file)
    cwd = Path(str(pending.get("cwd"))) if pending and pending.get("cwd") else Path.cwd().resolve()
    if not cwd.is_dir():
        raise RuntimeError("saved continuity cwd no longer exists")
    task = task or (Path(str(pending["task_file"])) if pending and pending.get("task_file") else None)
    project_state = project_state or (
        Path(str(pending["project_state_file"]))
        if pending and pending.get("project_state_file")
        else None
    )
    run_id = str(uuid.uuid4())
    affinity = f"codex-omni-{run_id}"
    prior_session = (
        str(pending.get("codex_session_id"))
        if pending and pending.get("codex_session_id")
        else None
    )
    mode = "RESUME" if prior_session else ("NEW_SESSION_HANDOFF" if pending else "NEW_SESSION")
    now = iso_now()
    manifest = {
        "schema_version": SCHEMA_VERSION,
        "run_id": run_id,
        "predecessor_run_id": pending.get("run_id") if pending else None,
        "architecture": ARCHITECTURE,
        "status": "RUNNING",
        "created_at": now,
        "started_at": now,
        "started_epoch": time.time(),
        "cwd": str(cwd),
        "launcher_mode": (
            "MANAGED_NAMED"
            if options.managed_profile
            else "DURABLE_TASK"
            if task or project_state
            else "INTERACTIVE"
        ),
        "launcher_argv": ["--task", str(task)] if task else [],
        "model": MODEL,
        "reasoning": REASONING,
        "affinity_id": affinity,
        "continuity_mode": mode,
        "codex_session_id": prior_session,
        "selected_connection": None,
        "selected_connection_id": None,
        "task_file": str(task) if task else None,
        "project_state_file": str(project_state) if project_state else None,
        "git": git_metadata(cwd),
        "handoff_count": 0,
        "max_handoffs": options.max_handoffs,
        "handoff_reason": "CAPACITY_RETURNED" if pending else None,
        "classification": None,
        "retry_at": None,
        "last_successful_continuation_at": now if pending else None,
        "route_snapshot": routes,
    }
    write_manifest(manifest)

    environment = os.environ.copy()
    environment["OMNIROUTE_API_KEY"] = key
    environment["CODEX_OMNI_SESSION_AFFINITY"] = affinity
    environment["OMNIROUTE_BASE_URL"] = lease_base_url(effective_profile)
    common_options = [
        "-p",
        effective_profile,
        "--model",
        MODEL,
        "--config",
        'model_reasoning_effort="xhigh"',
        "--sandbox",
        "danger-full-access",
        "--ask-for-approval",
        "never",
        "-C",
        str(cwd),
    ]
    if prior_session:
        command = [str(CODEX_BIN), "resume", *common_options, prior_session, *options.codex_args]
    elif pending:
        command = [str(CODEX_BIN), *common_options, *options.codex_args, safe_continuation_prompt(pending)]
    elif task:
        command = [str(CODEX_BIN), *common_options, *options.codex_args, initial_task_prompt(task, project_state)]
    else:
        command = [str(CODEX_BIN), *common_options, *options.codex_args]

    print("CODEX_ACCOUNT_SELECTED=NATIVE_POOL")
    print("STATUS=READY")
    print(f"MODEL={MODEL}")
    print(f"REASONING={REASONING}")
    print("AUTO_FAILOVER=ENABLED")
    print(f"CONTINUITY_MODE={mode}")
    print(f"STATE_PATH={run_path(run_id)}")
    leased_command = [sys.executable, str(LEASE_HELPER), "run", "--", *command]
    child = subprocess.Popen(leased_command, cwd=cwd, env=environment)
    monitor = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "--internal-monitor", run_id, str(child.pid)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    try:
        return_code = child.wait()
    except KeyboardInterrupt:
        return_code = child.wait()
    finally:
        monitor.terminate()
        try:
            monitor.wait(timeout=2)
        except subprocess.TimeoutExpired:
            monitor.kill()
            monitor.wait()

    manifest = load_manifest(run_id) or manifest
    waiting_marker = STATE_ROOT / "runs" / f"{run_id}.waiting"
    if (
        return_code == EXIT_WAITING
        or waiting_marker.exists()
        or manifest.get("status") == "WAITING_FOR_CAPACITY"
    ):
        manifest["status"] = "WAITING_FOR_CAPACITY"
        manifest["exit_code"] = return_code
        manifest["git_after"] = git_metadata(cwd)
        write_manifest(manifest)
        print("STATUS=WAITING_FOR_CAPACITY")
        print(f"RETRY_AT={manifest.get('retry_at') or 'UNKNOWN'}")
        return EXIT_WAITING
    manifest["status"] = "COMPLETED" if return_code == 0 else "INTERRUPTED"
    manifest["exit_code"] = return_code
    manifest["codex_session_id"] = newest_session(cwd, float(manifest["started_epoch"]) - 2) or manifest.get("codex_session_id")
    manifest["git_after"] = git_metadata(cwd)
    write_manifest(manifest)
    return return_code


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "--internal-monitor":
        return internal_monitor(sys.argv[2], int(sys.argv[3]))
    if len(sys.argv) == 2 and sys.argv[1] == "status":
        return status_command()
    if len(sys.argv) == 2 and sys.argv[1] == "maintain":
        return capacity_maintain_command()
    if len(sys.argv) == 2 and sys.argv[1] in {"doctor", "--self-test"}:
        return doctor_command()
    try:
        return launch(sys.argv[1:])
    except (OSError, RuntimeError, ValueError) as error:
        print(f"STATUS=CONFIGURATION_ERROR DETAIL={error}", file=sys.stderr)
        return EXIT_CONFIG


if __name__ == "__main__":
    raise SystemExit(main())
