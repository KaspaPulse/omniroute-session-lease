def git_metadata(cwd: Path) -> dict[str, Any]:
    def git(*arguments: str) -> subprocess.CompletedProcess[bytes]:
        return subprocess.run(
            ["git", "-C", str(cwd), *arguments],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )

    root_result = git("rev-parse", "--show-toplevel")
    if root_result.returncode != 0:
        return {
            "root": None,
            "branch": None,
            "head": None,
            "dirty": False,
            "status_digest": None,
            "recent_commits": [],
        }
    root = root_result.stdout.decode("utf-8", "replace").strip()
    branch = git("branch", "--show-current").stdout.decode("utf-8", "replace").strip() or None
    head = git("rev-parse", "HEAD").stdout.decode("ascii", "replace").strip() or None
    status = git("status", "--porcelain=v1", "-z", "--untracked-files=normal").stdout
    recent = git("log", "-5", "--format=%H").stdout.decode("ascii", "replace").splitlines()
    return {
        "root": root,
        "branch": branch,
        "head": head,
        "dirty": bool(status),
        "status_digest": hashlib.sha256(status).hexdigest(),
        "recent_commits": recent,
    }


def session_candidates(cwd: Path, since_epoch: float = 0) -> list[tuple[float, str]]:
    candidates: list[tuple[float, str]] = []
    if not SESSIONS_ROOT.is_dir():
        return candidates
    for path in SESSIONS_ROOT.glob("*/*/*/rollout-*.jsonl"):
        try:
            modified = path.stat().st_mtime
            if modified + 2 < since_epoch:
                continue
            with path.open("r", encoding="utf-8") as handle:
                first = json.loads(handle.readline())
            payload = first.get("payload") if isinstance(first, dict) else None
            payload = payload if isinstance(payload, dict) else first
            if not isinstance(payload, dict):
                continue
            session_id = payload.get("id")
            session_cwd = payload.get("cwd")
            if isinstance(session_id, str) and session_cwd == str(cwd):
                candidates.append((modified, session_id))
        except (OSError, ValueError):
            continue
    return sorted(candidates, reverse=True)


def newest_session(cwd: Path, since_epoch: float = 0) -> str | None:
    candidates = session_candidates(cwd, since_epoch)
    return candidates[0][1] if candidates else None


def resolve_connection_name(connection_id: str | None) -> str | None:
    if not connection_id:
        return None
    try:
        connection = sqlite3.connect(f"file:{DB_FILE}?mode=ro", uri=True, timeout=5)
        row = connection.execute(
            "SELECT name FROM provider_connections WHERE id=?", (connection_id,)
        ).fetchone()
        connection.close()
        return str(row[0]) if row else None
    except sqlite3.Error:
        return None


def affinity_connection(affinity: str) -> str | None:
    try:
        connection = sqlite3.connect(f"file:{DB_FILE}?mode=ro", uri=True, timeout=5)
        row = connection.execute(
            "SELECT connection_id FROM session_account_affinity WHERE session_key=? AND provider='codex'",
            (f"header:{affinity}",),
        ).fetchone()
        if row is None:
            row = connection.execute(
                "SELECT connection_id FROM session_account_affinity WHERE session_key=? AND provider='codex'",
                (affinity,),
            ).fetchone()
        connection.close()
        return str(row[0]) if row else None
    except sqlite3.Error:
        return None


def terminal_429_since(started_iso: str, connection_ids: list[str]) -> bool:
    if not connection_ids:
        return False
    try:
        connection = sqlite3.connect(f"file:{DB_FILE}?mode=ro", uri=True, timeout=5)
        placeholders = ",".join("?" for _ in connection_ids)
        row = connection.execute(
            f"""
            SELECT 1 FROM call_logs
            WHERE connection_id IN ({placeholders}) AND timestamp>=? AND status=429
            LIMIT 1
            """,
            [*connection_ids, started_iso],
        ).fetchone()
        connection.close()
        return row is not None
    except sqlite3.Error:
        return False


def internal_monitor(run_id: str, child_pid: int) -> int:
    manifest = load_manifest(run_id)
    if not manifest:
        return EXIT_CONFIG
    started_epoch = float(manifest.get("started_epoch") or time.time())
    started_iso = str(manifest.get("started_at") or iso_now())
    affinity = str(manifest.get("affinity_id") or "")
    cwd = Path(str(manifest.get("cwd") or "/"))
    previous_connection = manifest.get("selected_connection_id")
    while Path(f"/proc/{child_pid}").exists():
        manifest = load_manifest(run_id) or manifest
        session_id = newest_session(cwd, started_epoch - 2)
        if session_id and manifest.get("codex_session_id") != session_id:
            manifest["codex_session_id"] = session_id
            write_manifest(manifest)

        current_connection = affinity_connection(affinity)
        if current_connection and current_connection != previous_connection:
            if previous_connection:
                manifest["handoff_count"] = int(manifest.get("handoff_count") or 0) + 1
                manifest["handoff_reason"] = "TERMINAL_429_NATIVE_ROTATION"
                manifest["old_connection"] = resolve_connection_name(str(previous_connection))
                manifest["new_connection"] = resolve_connection_name(current_connection)
                manifest["last_successful_continuation_at"] = iso_now()
            manifest["selected_connection_id"] = current_connection
            manifest["selected_connection"] = resolve_connection_name(current_connection)
            previous_connection = current_connection
            write_manifest(manifest)

        routes = route_snapshot()
        route_ids = [str(route["connection_id"]) for route in routes]
        ready = [route for route in routes if route["ready"]]
        capacity_state, capacity_reason = capacity_assessment(routes)
        loop_guard = int(manifest.get("handoff_count") or 0) >= int(
            manifest.get("max_handoffs") or MAX_HANDOFFS
        )
        has_429 = terminal_429_since(started_iso, route_ids)
        if has_429 and (capacity_state == "EXHAUSTED" or loop_guard):
            future = [
                parse_ts(route.get("rate_limited_until"))
                for route in routes
                if parse_ts(route.get("rate_limited_until"))
            ]
            manifest["status"] = "WAITING_FOR_CAPACITY"
            manifest["handoff_reason"] = "MAX_HANDOFF_LOOP_GUARD" if loop_guard else "ALL_ROUTES_UNAVAILABLE"
            manifest["classification"] = "TRANSIENT_RATE_LIMIT_OR_QUOTA_WINDOW"
            manifest["retry_at"] = min(future).isoformat() if future else None
            manifest["route_snapshot"] = routes
            write_manifest(manifest)
            marker = STATE_ROOT / "runs" / f"{run_id}.waiting"
            marker.write_text("WAITING_FOR_CAPACITY\n", encoding="utf-8")
            os.chmod(marker, 0o600)
            try:
                os.kill(child_pid, signal.SIGINT)
            except ProcessLookupError:
                return 0
            for _ in range(25):
                if not Path(f"/proc/{child_pid}").exists():
                    return 0
                time.sleep(0.2)
            try:
                os.kill(child_pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            return 0
        if has_429 and not ready and capacity_state == "UNVERIFIED":
            invalidate_false_waiting(manifest, routes, capacity_reason)
            try:
                os.kill(child_pid, signal.SIGINT)
            except ProcessLookupError:
                return 0
            return 0
        time.sleep(2)
    return 0


def pending_waiting_manifest() -> dict[str, Any] | None:
    latest = latest_manifest()
    if latest and latest.get("status") in {"WAITING_FOR_CAPACITY", "CAPACITY_AVAILABLE"}:
        return latest
    return None


def capacity_maintain_command() -> int:
    pending = pending_waiting_manifest()
    if not pending:
        print("STATUS=NO_WAITING_RUN")
        print("MODEL_REQUESTS=0")
        return 0
    routes = route_snapshot()
    ready = [route for route in routes if route["ready"]]
    capacity_state, capacity_reason = capacity_assessment(routes)
    if not ready:
        if capacity_state == "UNVERIFIED":
            invalidate_false_waiting(pending, routes, capacity_reason)
            print("STATUS=CAPACITY_UNVERIFIED")
            print(f"DETAIL={capacity_reason}")
            print(f"STATE_PATH={run_path(str(pending['run_id']))}")
            print("MODEL_REQUESTS=0")
            return EXIT_CONFIG
        print("STATUS=WAITING_FOR_CAPACITY")
        print(f"STATE_PATH={run_path(str(pending['run_id']))}")
        print("MODEL_REQUESTS=0")
        return 0
    pending["status"] = "CAPACITY_AVAILABLE"
    pending["capacity_available_at"] = iso_now()
    pending["route_snapshot"] = routes
    write_manifest(pending)
    print("STATUS=CAPACITY_AVAILABLE")
    print(f"STATE_PATH={run_path(str(pending['run_id']))}")
    print("ACTION=RUN_CODEX_OMNI_TO_CONTINUE")
    print("MODEL_REQUESTS=0")
    return 0


