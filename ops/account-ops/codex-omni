def utcnow() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def iso_now() -> str:
    return utcnow().isoformat().replace("+00:00", "Z")


def parse_ts(value: Any) -> dt.datetime | None:
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone(dt.timezone.utc)


def load_json(path: Path, default: Any = None) -> Any:
    try:
        with path.open("r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


def ensure_state_root() -> None:
    STATE_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(STATE_ROOT, 0o700)
    (STATE_ROOT / "runs").mkdir(mode=0o700, exist_ok=True)
    os.chmod(STATE_ROOT / "runs", 0o700)


def atomic_json(path: Path, value: dict[str, Any]) -> None:
    ensure_state_root()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def run_path(run_id: str) -> Path:
    return STATE_ROOT / "runs" / f"{run_id}.json"


def load_manifest(run_id: str) -> dict[str, Any] | None:
    value = load_json(run_path(run_id))
    return value if isinstance(value, dict) else None


def write_manifest(value: dict[str, Any]) -> None:
    value["updated_at"] = iso_now()
    atomic_json(run_path(str(value["run_id"])), value)
    atomic_json(
        STATE_ROOT / "latest.json",
        {
            "schema_version": SCHEMA_VERSION,
            "run_id": value["run_id"],
            "status": value["status"],
            "updated_at": value["updated_at"],
        },
    )


def latest_manifest() -> dict[str, Any] | None:
    pointer = load_json(STATE_ROOT / "latest.json")
    if not isinstance(pointer, dict) or not isinstance(pointer.get("run_id"), str):
        return None
    return load_manifest(pointer["run_id"])


def parse_env_key(path: Path) -> str:
    mode = path.stat().st_mode & 0o777
    if not path.is_file() or mode & 0o077:
        raise RuntimeError("continuity environment file must be a private regular file")
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if stripped.startswith("export OMNIROUTE_API_KEY="):
            value = stripped.split("=", 1)[1]
        elif stripped.startswith("OMNIROUTE_API_KEY="):
            value = stripped.split("=", 1)[1]
        else:
            continue
        parsed = shlex.split(value)
        if len(parsed) == 1 and parsed[0]:
            return parsed[0]
    raise RuntimeError("continuity API key is missing")


def profile_file_for(profile: str) -> Path:
    if profile == PROFILE:
        return PROFILE_FILE
    config = load_json(ACCOUNTS_FILE, {})
    accounts = config.get("accounts") if isinstance(config, dict) else None
    if isinstance(accounts, list):
        for account in accounts:
            if not isinstance(account, dict):
                continue
            if str(account.get("profile") or "") != profile:
                continue
            configured = account.get("profile_file")
            if configured:
                return Path(str(configured)).expanduser().resolve()
            break
    return Path("/home") / LOCAL_OWNER_NAME / ".codex" / f"{profile}.config.toml"


def lease_base_url(profile: str) -> str:
    path = profile_file_for(profile)
    if not private_regular(path):
        raise RuntimeError("managed Codex profile must be a private regular file")
    try:
        with path.open("rb") as handle:
            config = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise RuntimeError("managed Codex profile cannot be parsed") from error
    providers = config.get("model_providers")
    providers = providers if isinstance(providers, dict) else {}
    provider = providers.get("omniroute")
    provider = provider if isinstance(provider, dict) else {}
    raw = str(provider.get("base_url") or "").strip()
    parsed = urllib.parse.urlsplit(raw)
    if (
        parsed.scheme not in {"http", "https"}
        or not parsed.hostname
        or parsed.username
        or parsed.password
        or parsed.query
        or parsed.fragment
    ):
        raise RuntimeError("managed Codex profile has an invalid OmniRoute base_url")
    route_path = parsed.path.rstrip("/")
    if not route_path.endswith("/v1"):
        raise RuntimeError("managed Codex profile OmniRoute base_url must end in /v1")
    lease_path = route_path[:-3].rstrip("/")
    endpoint = urllib.parse.urlunsplit(
        (parsed.scheme, parsed.netloc, lease_path, "", "")
    ).rstrip("/")
    if not endpoint:
        raise RuntimeError("managed Codex profile has an empty OmniRoute lease endpoint")
    return endpoint


def configured_connections() -> dict[str, str]:
    config = load_json(ACCOUNTS_FILE, {})
    accounts = config.get("accounts") if isinstance(config, dict) else None
    if not isinstance(accounts, list):
        return {}
    names = [
        str(account.get("connection") or "")
        for account in accounts
        if isinstance(account, dict) and account.get("connection")
    ]
    if not names:
        return {}
    connection = sqlite3.connect(f"file:{DB_FILE}?mode=ro", uri=True, timeout=5)
    try:
        placeholders = ",".join("?" for _ in names)
        rows = connection.execute(
            f"SELECT id,name FROM provider_connections WHERE provider='codex' AND name IN ({placeholders})",
            names,
        ).fetchall()
        return {str(name): str(connection_id) for connection_id, name in rows}
    finally:
        connection.close()


def route_snapshot() -> list[dict[str, Any]]:
    configured = configured_connections()
    state = load_json(OPS_STATE_FILE, {})
    account_state = state.get("accounts") if isinstance(state, dict) else {}
    account_state = account_state if isinstance(account_state, dict) else {}
    if not configured:
        return []
    connection = sqlite3.connect(f"file:{DB_FILE}?mode=ro", uri=True, timeout=5)
    connection.row_factory = sqlite3.Row
    try:
        placeholders = ",".join("?" for _ in configured.values())
        rows = connection.execute(
            f"""
            SELECT id,name,is_active,test_status,rate_limited_until,error_code,last_error_type
            FROM provider_connections WHERE id IN ({placeholders})
            """,
            list(configured.values()),
        ).fetchall()
    finally:
        connection.close()
    now = utcnow()
    result = []
    for row in rows:
        ops = account_state.get(str(row["name"]))
        ops = ops if isinstance(ops, dict) else {}
        limited_until = parse_ts(row["rate_limited_until"])
        db_ready = bool(
            int(row["is_active"] or 0) == 1
            and str(row["test_status"] or "").lower() == "active"
            and (limited_until is None or limited_until <= now)
        )
        ops_status = str(ops.get("status") or "UNKNOWN").upper()
        # NEEDS_REVIEW is an operational-verification state, not evidence that
        # native proxy capacity is exhausted.  If OmniRoute itself still marks
        # the connection active and outside cooldown, allow its request-time
        # health/failover path to decide.  Hard unavailability remains closed.
        ready = db_ready and ops_status not in HARD_UNAVAILABLE_STATUSES
        result.append(
            {
                "connection_id": str(row["id"]),
                "connection": str(row["name"]),
                "status": "READY" if ops_status == "READY" and ready else ops_status,
                "ready": ready,
                "readiness_source": (
                    "DB_AND_OPS"
                    if ready and ops_status == "READY"
                    else "DB_ACTIVE_OPS_REVIEW"
                    if ready
                    else "UNAVAILABLE"
                ),
                "rate_limited_until": limited_until.isoformat() if limited_until else None,
                "error_code": row["error_code"],
                "error_type": row["last_error_type"],
            }
        )
    return sorted(result, key=lambda value: value["connection"])


def capacity_assessment(routes: list[dict[str, Any]]) -> tuple[str, str]:
    """Classify route evidence without turning uncertainty into exhaustion."""
    if any(bool(route.get("ready")) for route in routes):
        return "READY", "AT_LEAST_ONE_NATIVE_ROUTE_USABLE"
    if not routes:
        return "UNVERIFIED", "EMPTY_ROUTE_SNAPSHOT"
    statuses = {str(route.get("status") or "UNKNOWN").upper() for route in routes}
    if statuses <= {"NEEDS_REVIEW", "UNKNOWN"}:
        return "UNVERIFIED", "OPS_REVIEW_ONLY_SNAPSHOT"
    if all(status in HARD_UNAVAILABLE_STATUSES for status in statuses):
        return "EXHAUSTED", "ALL_ROUTES_AUTHORITATIVELY_UNAVAILABLE"
    return "UNVERIFIED", "MIXED_OR_INCONCLUSIVE_ROUTE_SNAPSHOT"


